<div class="small">Generated: {datetime.utcnow().strftime("%Y-%m-%d %H:%M:%S UTC")}</div>

<div class="card">
<h2>Executive summary</h2>
<p>Pipeline extracts latent signals (PCA + Autoencoder) and trains an ensemble (LogReg, GB, RF) to forecast MPC decision classes (-1=cut, 0=hold, 1=hike).</p>
<pre style="background:#fafafa;padding:8px;border-radius:6px">{report}</pre>
</div>

<h2>Validation</h2>
<h3>Confusion matrix</h3>
{img_tag(cm_path,'70%')}
<h3>Predicted probabilities over time</h3>
{img_tag(prob_path,'95%')}
<h3>ROC curves</h3>
{"".join(img_tag(p,'45%') for p in roc_paths)}

<h2>Latent signals extracted</h2>
<p>Included components: PCA components ({len(pca_cols)}) and Autoencoder bottleneck ({len(ae_cols)}).</p>

<h2>Feature importance</h2>
{img_tag(imp_path,'80%')}
<h3>Permutation importance (holdout)</h3>
{img_tag(perm_path,'80%')}

<h2>Scenario analysis (top features)</h2>
{"".join(img_tag(p,'70%') for p in scenario_paths)}

"""

if shap_summary_path:
    report_html += "<h2>SHAP summary (approx.)</h2>" + img_tag(shap_summary_path, "70%")

# Add model tuning table
tuning_rows = ""
for name, rs in best_searches.items():
    tuning_rows += f"<tr><td>{name}</td><td>{rs.best_score_:.3f}</td><td><pre>{json.dumps(rs.best_params_, default=str)}</pre></td></tr>"

report_html += f"""
<h2>Model selection (time-series CV)</h2>
<table><tr><th>Model</th><th>Best CV f1_macro</th><th>Best params</th></tr>
{tuning_rows}
</table>

<div class="card"><h3>How to use</h3>
<p>To use with your data: set DATA_PATH at the top to your CSV path (must contain 'date' and 'y' columns and numeric features). The pipeline will standardize features, extract latent signals automatically, and retrain. All artifacts saved under {OUTDIR}.</p>
</div>
</body></html>
"""

with open(os.path.join(OUTDIR, "report.html"), "w", encoding="utf-8") as f:
    f.write(report_html)

# Save some artifacts / metadata
meta = {
    "date_generated": datetime.utcnow().isoformat(),
    "use_pca": USE_PCA,
    "n_pca": N_PCA,
    "use_autoencoder": USE_AE and TF_AVAILABLE,
    "ae_bottleneck_dim": AE_BOTTLENECK_DIM,
    "combined_features": combined_feature_cols,
    "models": {k: {"best_score": float(best_searches[k].best_score_), "best_params": best_searches[k].best_params_} for k in best_searches}
}
with open(os.path.join(OUTDIR, "metadata.json"), "w") as f:
    json.dump(meta, f, indent=2)

print("Done. Artifacts saved to:", OUTDIR)
print("Report:", os.path.join(OUTDIR, "report.html"))
print("Model:", os.path.join(OUTDIR, "ensemble_model.joblib"))
